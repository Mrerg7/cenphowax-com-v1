---
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' || path === '/index.html' : path.startsWith(href);

const links = [
  { href: '/services/', label: 'Services' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/blog/', label: 'Guides' },
  { href: '/about/', label: 'About' },
];
---

<header class="sticky top-0 z-50 border-b border-blush-100/70 bg-blush-50/85 backdrop-blur-md">
  <div class="container-narrow">
    <div class="flex h-14 items-center justify-between sm:h-16">
      <a href="/" class="flex items-center gap-3" aria-label="CenPho Wax home">
        <span class="flex h-8 w-8 items-center justify-center rounded-full border border-champagne-400/50 bg-blush-950 text-champagne-400 sm:h-9 sm:w-9">
          <span class="font-display text-sm font-semibold">C</span>
        </span>
        <span class="leading-tight">
          <span class="block font-display text-lg font-semibold tracking-tight text-blush-950 sm:text-xl">CenPho Wax</span>
          <span class="hidden text-[10px] uppercase tracking-widestx text-blush-600 sm:block">Central Phoenix</span>
        </span>
      </a>

      <nav class="hidden items-center gap-6 md:flex lg:gap-7" aria-label="Main navigation">
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'text-sm font-medium transition',
                isActive(link.href) ? 'text-blush-950 underline decoration-champagne-500 decoration-2 underline-offset-8' : 'text-blush-800 hover:text-blush-600',
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <a href="/contact/" class="rounded-full bg-blush-800 px-4 py-2 text-xs font-medium tracking-wide text-white hover:bg-blush-700">Book / Contact</a>
      </nav>

      <button type="button" id="mobile-menu-btn" class="inline-flex h-10 w-10 items-center justify-center rounded-full text-blush-800 hover:bg-blush-100 md:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle menu">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-blush-100 bg-blush-50 md:hidden">
    <div class="container-narrow space-y-1 py-3">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'block rounded-xl px-3 py-3 text-base font-medium',
              isActive(link.href) ? 'bg-blush-100 text-blush-950' : 'text-blush-900',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a href="/contact/" class="mt-2 block rounded-full bg-blush-800 px-4 py-3 text-center text-sm font-medium text-white">Book / Contact</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', (!isOpen).toString());
    });
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
