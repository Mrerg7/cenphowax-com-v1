---
import { domain, priceLabel, acquisitionMailto, site } from '../config/site';
---

<div
  id="sticky-cta"
  class="fixed inset-x-0 bottom-0 z-50 translate-y-full opacity-0 transition duration-300 md:hidden"
  aria-label="Domain acquisition actions"
>
  <div class="border-t border-champagne-400/30 bg-blush-950/95 px-4 py-3 backdrop-blur-md">
    <div class="flex items-center gap-3">
      <div class="min-w-0 flex-1">
        <p class="truncate text-[10px] font-medium uppercase tracking-widestx text-champagne-400">
          {domain.name} for sale
        </p>
        <p class="truncate text-sm font-semibold text-white">
          {priceLabel}<span class="max-[360px]:hidden"> USD</span>
        </p>
      </div>
      <a
        href={domain.salePage}
        class="inline-flex min-h-11 shrink-0 items-center rounded-full border border-white/25 px-4 text-xs font-medium text-white"
      >
        Details
      </a>
      <a
        href={acquisitionMailto}
        class="inline-flex min-h-11 shrink-0 items-center gap-1.5 rounded-full bg-champagne-400 px-4 text-xs font-semibold text-blush-950"
      >
        Inquire
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
    <p class="mt-1.5 text-[10px] text-blush-400">Serious inquiries · {site.email}</p>
  </div>
</div>

<script>
  const bar = document.getElementById('sticky-cta');
  if (bar) {
    const toggle = () => {
      if (window.scrollY > 360) {
        bar.classList.remove('translate-y-full', 'opacity-0');
      } else {
        bar.classList.add('translate-y-full', 'opacity-0');
      }
    };
    toggle();
    window.addEventListener('scroll', toggle, { passive: true });
  }
</script>
