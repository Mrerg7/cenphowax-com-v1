---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string | false;
  robots?: string;
}

const POSTER =
  'https://customer-wa9cpywo3l4jte5c.cloudflarestream.com/4b63e1d5f2332b277027a8c7baef39a3/thumbnails/thumbnail.jpg?time=&height=600';

const {
  title = 'CenPho Wax | Central Phoenix Brazilian Wax',
  description = 'An elegant Central Phoenix Brazilian wax studio concept. Hard wax for sensitive areas and smooth results for 3 to 4 weeks. Domain available.',
  ogImage = POSTER,
  canonical = 'https://cenphowax.com/',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1',
} = Astro.props;

const siteName = 'CenPho Wax';
const pageUrl = canonical || 'https://cenphowax.com/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical !== false && <link rel="canonical" href={canonical} />}
    <meta name="google-site-verification" content="QqL1gcUdT04fDOsbT9z-u0yhkYp8MJzDanJ2gDxfx3M" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#301d17" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteName,
      "url": "https://cenphowax.com",
      "description": description
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": title,
      "description": description,
      "url": pageUrl,
      "primaryImageOfPage": { "@type": "ImageObject", "url": ogImage },
      "about": {
        "@type": "Thing",
        "name": "Central Phoenix Brazilian Wax",
        "description": "Hard-wax Brazilian services designed for sensitive areas, with smooth results lasting 3 to 4 weeks."
      },
      "datePublished": "2026-09-12",
      "dateModified": "2026-09-12"
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How long does Brazilian waxing last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wax epilation extracts hair from the root and typically provides smooth skin for 3 to 4 weeks. With consistent sessions, regrowth often becomes finer."
          }
        },
        {
          "@type": "Question",
          "name": "Why use hard wax for a Brazilian?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hard wax is ideal for the bikini line and other sensitive areas because it adheres to hair rather than skin, reducing pull and irritation."
          }
        }
      ]
    })} />
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
  </body>
</html>
