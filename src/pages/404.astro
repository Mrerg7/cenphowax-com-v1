---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page not found | CenPho Wax"
  description="The page you are looking for does not exist. Return to the CenPho Wax homepage."
  canonical={false}
  robots="noindex, follow"
>
  <Header />
  <main id="main-content" class="flex-1">
    <section class="container-narrow flex flex-col items-center justify-center py-24 text-center sm:py-32">
      <p class="text-[11px] font-medium uppercase tracking-widestx text-champagne-700">Error 404</p>
      <h1 class="mt-4 font-display text-4xl font-semibold text-blush-950 sm:text-5xl">Page not found</h1>
      <p class="mt-4 max-w-md text-sm leading-relaxed text-blush-700 sm:text-base">
        The page you are looking for does not exist or has been moved. Start from the homepage, or jump straight to
        services, pricing, or the domain listing.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a
          href="/"
          class="inline-flex min-h-11 items-center justify-center rounded-full bg-blush-800 px-7 py-3 text-sm font-medium text-white hover:bg-blush-700"
        >
          Back to homepage
        </a>
        <a
          href="/domain-for-sale/"
          class="inline-flex min-h-11 items-center justify-center rounded-full border border-blush-300 px-7 py-3 text-sm font-medium text-blush-900 hover:bg-blush-100"
        >
          Domain for sale
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
