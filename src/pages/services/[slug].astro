---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { services, getService } from '../../config/services';
import { site } from '../../config/site';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const schemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.name,
    serviceType: service.serviceType,
    description: service.metaDescription,
    provider: { '@id': `${site.url}/#business` },
    areaServed: { '@type': 'AdministrativeArea', name: 'Central Phoenix, AZ' },
    url: new URL(`/services/${service.slug}/`, site.url).href,
    offers: {
      '@type': 'Offer',
      price: String(service.price),
      priceCurrency: 'USD',
      url: new URL('/pricing/', site.url).href,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: service.faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];

const related = service.related.map((slug) => getService(slug)!).filter(Boolean);
---

<Layout
  title={`${service.name} in Central Phoenix | $${service.price} | CenPho Wax`}
  description={service.metaDescription}
  canonical={new URL(`/services/${service.slug}/`, site.url).href}
  schemas={schemas}
>
  <Header />
  <Breadcrumbs
    items={[
      { name: 'Services', path: '/services/' },
      { name: service.name, path: `/services/${service.slug}/` },
    ]}
  />

  <main id="main-content" class="flex-1">
    <section class="section-padding bg-white">
      <div class="container-narrow grid gap-12 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <p class="text-[11px] font-medium uppercase tracking-widestx text-blush-600">{service.serviceType}</p>
          <h1 class="mt-3 font-display text-4xl font-semibold text-blush-950 sm:text-5xl">{service.name}</h1>
          <p class="mt-4 text-base leading-relaxed text-blush-800 sm:text-lg">{service.summary}</p>

          <div class="prose prose-blush mt-10 max-w-none">
            {service.intro.map((paragraph) => <p>{paragraph}</p>)}

            <h2>What to expect</h2>
            <ul>
              {service.expectations.map((item) => <li>{item}</li>)}
            </ul>

            <h2>How to prepare</h2>
            <ul>
              {service.prep.map((item) => <li>{item}</li>)}
            </ul>

            <h2>Afterward</h2>
            <p>
              Avoid heat, tight clothing, and heavy workouts for 24 hours, and keep the area clean. Our{' '}
              <a href="/aftercare/">aftercare guide</a> covers the full first week — including how desert sun and
              swimming change the routine.
            </p>
          </div>

          <div class="mt-10">
            <h2 class="font-display text-2xl font-semibold text-blush-950">Common questions</h2>
            <dl class="mt-5 space-y-5">
              {
                service.faq.map((item) => (
                  <div class="card">
                    <dt class="font-medium text-blush-950">{item.q}</dt>
                    <dd class="mt-2 text-sm leading-relaxed text-blush-700">{item.a}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>

        <aside class="lg:col-span-1">
          <div class="sticky top-24 rounded-3xl border border-blush-100 bg-blush-50 p-6">
            <p class="text-[11px] font-medium uppercase tracking-widestx text-blush-600">At a glance</p>
            <dl class="mt-4 space-y-4 text-sm">
              <div class="flex items-baseline justify-between gap-4 border-b border-blush-100 pb-3">
                <dt class="text-blush-600">Price</dt>
                <dd class="font-display text-2xl font-semibold text-blush-950">${service.price}</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 border-b border-blush-100 pb-3">
                <dt class="text-blush-600">Duration</dt>
                <dd class="font-medium text-blush-950">{service.duration}</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 border-b border-blush-100 pb-3">
                <dt class="text-blush-600">Wax</dt>
                <dd class="font-medium text-blush-950">Hard wax</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-blush-600">Results</dt>
                <dd class="font-medium text-blush-950">3–4 weeks</dd>
              </div>
            </dl>
            <a href="/contact/" class="btn-primary mt-6 flex justify-center">Book this service</a>
            <a href="/pricing/" class="mt-3 block text-center text-xs text-blush-600 underline underline-offset-4 hover:text-blush-900">Full pricing</a>
          </div>
        </aside>
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="section-padding border-t border-blush-100 bg-blush-50">
          <div class="container-narrow">
            <h2 class="font-display text-2xl font-semibold text-blush-950">Related services</h2>
            <div class="mt-6 grid gap-5 sm:grid-cols-2">
              {related.map((item) => (
                <a href={`/services/${item.slug}/`} class="card group transition hover:border-champagne-400/60">
                  <div class="flex items-baseline justify-between gap-3">
                    <h3 class="font-display text-xl font-semibold text-blush-950">{item.name}</h3>
                    <span class="font-display text-lg font-semibold text-champagne-700">${item.price}</span>
                  </div>
                  <p class="mt-2 text-sm leading-relaxed text-blush-700">{item.summary}</p>
                </a>
              ))}
            </div>
            <div class="mt-8 flex flex-wrap gap-4 text-sm">
              <a href="/services/" class="font-medium text-blush-900 underline decoration-champagne-500 underline-offset-4">All services</a>
              <a href="/pricing/" class="font-medium text-blush-900 underline decoration-champagne-500 underline-offset-4">Pricing</a>
              <a href="/faq/" class="font-medium text-blush-900 underline decoration-champagne-500 underline-offset-4">FAQ</a>
              <a href="/contact/" class="font-medium text-blush-900 underline decoration-champagne-500 underline-offset-4">Book / Contact</a>
            </div>
          </div>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>
