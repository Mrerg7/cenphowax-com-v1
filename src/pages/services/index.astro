---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { services } from '../../config/services';
---

<Layout
  title="Waxing Services in Central Phoenix | CenPho Wax"
  description="Brazilian, bikini, underarm, facial, leg, and arm waxing in Central Phoenix. Hard wax only, private appointments, results lasting 3–4 weeks."
>
  <Header />
  <Breadcrumbs items={[{ name: 'Services', path: '/services/' }]} />

  <main class="flex-1">
    <section class="section-padding bg-white">
      <div class="container-narrow">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-[11px] font-medium uppercase tracking-widestx text-blush-600">Services</p>
          <h1 class="mt-3 font-display text-4xl font-semibold text-blush-950 sm:text-5xl">Waxing services, hard wax only</h1>
          <p class="mt-4 text-base leading-relaxed text-blush-800 sm:text-lg">
            Every service at CenPho Wax is done with hard wax in a private, appointment-led room. Hard wax adheres to
            hair rather than skin — less pull, calmer finish, results that hold for 3 to 4 weeks.
          </p>
        </div>

        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            services.map((service) => (
              <a href={`/services/${service.slug}/`} class="card group flex flex-col transition hover:border-champagne-400/60 hover:shadow-md">
                <div class="flex items-baseline justify-between gap-3">
                  <h2 class="font-display text-2xl font-semibold text-blush-950">{service.name}</h2>
                  <span class="font-display text-xl font-semibold text-champagne-500">${service.price}</span>
                </div>
                <p class="mt-1 text-xs uppercase tracking-widestx text-blush-500">{service.duration}</p>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-blush-700">{service.summary}</p>
                <span class="mt-5 text-sm font-medium text-blush-800 transition group-hover:text-champagne-500">
                  View service →
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-padding border-t border-blush-100 bg-blush-50">
      <div class="container-narrow grid gap-8 lg:grid-cols-3">
        <div>
          <h2 class="font-display text-2xl font-semibold text-blush-950">Before you book</h2>
          <p class="mt-3 text-sm leading-relaxed text-blush-700">
            Grow hair to ¼–½ inch, skip exfoliants and retinoids for 48 hours, and arrive with clean skin. Full
            preparation is covered on every service page.
          </p>
          <a href="/faq/" class="mt-4 inline-block text-sm font-medium text-blush-900 underline decoration-champagne-500 underline-offset-4">Read the FAQ →</a>
        </div>
        <div>
          <h2 class="font-display text-2xl font-semibold text-blush-950">After your session</h2>
          <p class="mt-3 text-sm leading-relaxed text-blush-700">
            The first 48 hours decide how smooth the weeks that follow feel. Our aftercare guide covers exfoliation,
            sun, swimming, and ingrown-hair prevention in desert heat.
          </p>
          <a href="/aftercare/" class="mt-4 inline-block text-sm font-medium text-blush-900 underline decoration-champagne-500 underline-offset-4">Aftercare guide →</a>
        </div>
        <div>
          <h2 class="font-display text-2xl font-semibold text-blush-950">What it costs</h2>
          <p class="mt-3 text-sm leading-relaxed text-blush-700">
            Straight per-session pricing — no packages to decode. Brazilian $65, bikini $45, underarms $20, with full
            pricing on the pricing page.
          </p>
          <a href="/pricing/" class="mt-4 inline-block text-sm font-medium text-blush-900 underline decoration-champagne-500 underline-offset-4">See pricing →</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
