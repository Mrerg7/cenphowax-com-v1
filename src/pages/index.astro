---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { services } from '../config/services';
import { acquisitionMailto } from '../config/site';

const STREAM_SRC =
  'https://customer-wa9cpywo3l4jte5c.cloudflarestream.com/4b63e1d5f2332b277027a8c7baef39a3/iframe?muted=true&loop=true&autoplay=true&poster=https%3A%2F%2Fcustomer-wa9cpywo3l4jte5c.cloudflarestream.com%2F4b63e1d5f2332b277027a8c7baef39a3%2Fthumbnails%2Fthumbnail.jpg%3Ftime%3D%26height%3D600&controls=false';

const POSTER =
  'https://customer-wa9cpywo3l4jte5c.cloudflarestream.com/4b63e1d5f2332b277027a8c7baef39a3/thumbnails/thumbnail.jpg?time=&height=600';

const homeFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How long does Brazilian waxing last?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Wax epilation extracts hair from the root and typically provides smooth skin for 3 to 4 weeks. With consistent sessions, regrowth often becomes finer.',
      },
    },
    {
      '@type': 'Question',
      name: 'Why use hard wax for a Brazilian?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Hard wax is ideal for the bikini line and other sensitive areas because it adheres to hair rather than skin, reducing pull and irritation.',
      },
    },
  ],
};

const exploreLinks = [
  { href: '/services/', title: 'Services', body: 'Brazilian, bikini, underarms, face, legs, and arms — hard wax only.' },
  { href: '/pricing/', title: 'Pricing', body: 'Straight per-session prices, from $20 underarms to $65 Brazilian.' },
  { href: '/domain-for-sale/', title: 'Domain for Sale', body: 'cenphowax.com is available — $50,000, escrow-protected transfer.' },
  { href: '/aftercare/', title: 'Aftercare', body: 'The first 48 hours and the week that follows — desert edition.' },
  { href: '/faq/', title: 'FAQ', body: 'Prep, pain, sensitivity, and scheduling — answered before you book.' },
  { href: '/blog/', title: 'Guides', body: 'Long-tail reading on technique, timing, and Phoenix summers.' },
  { href: '/about/', title: 'About', body: 'Who we are, how we work, and the neighborhoods we serve.' },
];
---

<Layout schemas={[homeFaqSchema]} preloadImage={POSTER}>
  <Header />

  <main id="main-content" class="flex-1">
    <section class="relative bg-blush-950">
      <!--
        Mobile: match Stream aspect (no letterboxing) and place copy BELOW the frame.
        sm+: keep cinematic overlay on the Stream aspect box.
      -->
      <div class="hero-stream relative w-full overflow-hidden">
        <img
          src={POSTER}
          alt=""
          aria-hidden="true"
          width="1280"
          height="695"
          loading="eager"
          fetchpriority="high"
          class="hero-stream__media absolute inset-0 h-full w-full object-cover"
        />
        <iframe
          data-src={STREAM_SRC}
          title="CenPho Wax hero video"
          loading="eager"
          class="hero-stream__media absolute inset-0 h-full w-full max-w-none border-0"
          allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
          allowfullscreen="true"
        ></iframe>
        <div class="pointer-events-none absolute inset-0 hidden bg-gradient-to-t from-blush-950 via-blush-950/50 to-blush-950/20 sm:block"></div>
        <div class="absolute inset-0 hidden items-end sm:flex">
          <div class="container-narrow w-full pb-12 pt-20">
            <p class="mb-3 text-xs font-medium uppercase tracking-widestx text-champagne-400">
              Central Phoenix · Brazilian Wax
            </p>
            <h1 class="font-display text-6xl font-semibold leading-[0.95] text-white lg:text-7xl">
              CenPho <span class="italic text-champagne-400">Wax</span>
            </h1>
            <p class="mt-5 max-w-lg text-lg leading-relaxed text-blush-100/90">
              A refined studio concept for Brazilian waxing in the heart of Phoenix — hard wax, quieter rooms, lasting smoothness.
            </p>
            <div class="mt-8 flex flex-row gap-3">
              <a
                href="/domain-for-sale/"
                class="pointer-events-auto inline-flex min-h-11 w-full items-center justify-center rounded-full bg-champagne-400 px-7 py-3 text-sm font-semibold tracking-wide text-blush-950 transition hover:bg-champagne-500 sm:w-auto"
              >
                Acquire this domain
              </a>
              <a href="#method" class="btn-secondary pointer-events-auto">Explore the studio</a>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-blush-950 px-4 pb-10 pt-6 sm:hidden">
        <p class="mb-2 text-[10px] font-medium uppercase tracking-widestx text-champagne-400">
          Central Phoenix · Brazilian Wax
        </p>
        <h1 class="font-display text-[2.5rem] font-semibold leading-[0.95] text-white">
          CenPho <span class="italic text-champagne-400">Wax</span>
        </h1>
        <p class="mt-3 max-w-lg text-sm leading-relaxed text-blush-100/90">
          A refined studio concept for Brazilian waxing in the heart of Phoenix — hard wax, quieter rooms, lasting smoothness.
        </p>
        <div class="mt-5 flex flex-col gap-2">
          <a
            href="/domain-for-sale/"
            class="inline-flex min-h-11 w-full items-center justify-center rounded-full bg-champagne-400 px-7 py-3 text-sm font-semibold text-blush-950 transition hover:bg-champagne-500"
          >
            Acquire this domain — $50,000
          </a>
          <a href="#method" class="btn-secondary">Explore the studio</a>
        </div>
      </div>
    </section>

    <section id="method" class="section-padding bg-blush-50">
      <div class="container-narrow">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-[11px] font-medium uppercase tracking-widestx text-blush-600">The Method</p>
          <h2 class="mt-3 font-display text-3xl font-semibold text-blush-950 sm:text-5xl">Brazilian wax, done with care</h2>
          <p class="mt-4 text-base leading-relaxed text-blush-800 sm:text-lg">
            Wax epilation extracts hair from the root using warm or hard wax, providing smooth skin for 3 to 4 weeks.
            The sensation is short and sharp — generally considered less fatiguing than continuous mechanical epilation.
          </p>
        </div>

        <div class="mt-12 grid gap-4 sm:gap-6 md:grid-cols-2">
          <article class="card">
            <h3 class="font-display text-2xl font-semibold text-blush-950">Effectiveness</h3>
            <p class="mt-3 text-sm leading-relaxed text-blush-700">Removes coarse and fine hair. With consistent sessions, regrowth often becomes finer over time.</p>
          </article>
          <article class="card">
            <h3 class="font-display text-2xl font-semibold text-blush-950">Best for</h3>
            <p class="mt-3 text-sm leading-relaxed text-blush-700">Ideal for sensitive areas such as the bikini line and underarms — especially with hard wax, which adheres to hair, not skin.</p>
          </article>
          <article class="card">
            <h3 class="font-display text-2xl font-semibold text-blush-950">Preparation</h3>
            <p class="mt-3 text-sm leading-relaxed text-blush-700">Hair should be at least ¼ to ½ inch long. Time between sessions is part of the method, not a delay.</p>
          </article>
          <article class="card">
            <h3 class="font-display text-2xl font-semibold text-blush-950">Skin impact</h3>
            <p class="mt-3 text-sm leading-relaxed text-blush-700">Provides gentle exfoliation by lifting dead skin. Temporary redness can occur and typically settles quickly.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="studio" class="section-padding bg-white">
      <div class="container-narrow grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-widestx text-blush-600">The Studio</p>
          <h2 class="mt-3 font-display text-3xl font-semibold text-blush-950 sm:text-5xl">Designed for Central Phoenix</h2>
          <p class="mt-4 text-base leading-relaxed text-blush-800 sm:text-lg">
            CenPho is shorthand for Central Phoenix — Arcadia, Midtown, downtown, and the corridors people already use.
            A Brazilian studio here needs a name that is local, short, and unmistakable.
          </p>
          <ul class="mt-8 space-y-4 text-sm text-blush-800 sm:text-base">
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-champagne-500"></span><span>Hard wax preferred for Brazilian and underarm work.</span></li>
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-champagne-500"></span><span>Results that last 3 to 4 weeks in a desert climate.</span></li>
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-champagne-500"></span><span>A quiet, appointment-led format rather than a high-volume salon floor.</span></li>
          </ul>
        </div>
        <div class="rounded-3xl border border-blush-100 bg-blush-50 p-6 sm:p-8">
          <dl class="space-y-5">
            <div class="flex flex-col gap-1 border-b border-blush-100 pb-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
              <dt class="text-sm text-blush-600">Neighborhood</dt>
              <dd class="font-display text-xl font-semibold text-blush-900 sm:text-2xl sm:text-right">Central Phoenix</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-blush-100 pb-4">
              <dt class="text-sm text-blush-600">Signature service</dt>
              <dd class="font-display text-xl font-semibold text-blush-900 sm:text-2xl">Brazilian</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-blush-100 pb-4">
              <dt class="text-sm text-blush-600">Duration</dt>
              <dd class="font-display text-xl font-semibold text-blush-900 sm:text-2xl">3–4 weeks</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-sm text-blush-600">Preferred wax</dt>
              <dd class="font-display text-xl font-semibold text-blush-900 sm:text-2xl">Hard wax</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section id="explore" class="section-padding bg-white">
      <div class="container-narrow">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-[11px] font-medium uppercase tracking-widestx text-blush-600">Explore</p>
          <h2 class="mt-3 font-display text-3xl font-semibold text-blush-950 sm:text-5xl">Everything worth reading before you book</h2>
          <p class="mt-4 text-base leading-relaxed text-blush-800 sm:text-lg">
            Services, pricing, preparation, and guides — all written for waxing in Central Phoenix.
          </p>
        </div>

        <div class="mt-10 grid gap-4 sm:gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            exploreLinks.map((link) => (
              <a href={link.href} class="card group transition hover:border-champagne-400/60 hover:shadow-md">
                <h3 class="font-display text-2xl font-semibold text-blush-950 transition group-hover:text-champagne-700">{link.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-blush-700">{link.body}</p>
                <span class="mt-4 block text-sm font-medium text-blush-800 transition group-hover:text-champagne-700">Explore →</span>
              </a>
            ))
          }
        </div>

        <div class="mt-10 flex flex-wrap justify-center gap-3">
          {
            services.slice(0, 4).map((service) => (
              <a
                href={`/services/${service.slug}/`}
                class="rounded-full border border-blush-200 bg-blush-50 px-4 py-2 text-xs font-medium text-blush-800 transition hover:border-champagne-400/60 hover:text-blush-950"
              >
                {service.name} · ${service.price}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section id="brand" class="section-padding bg-blush-50">
      <div class="container-narrow grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-widestx text-blush-600">The Domain · For Sale</p>
          <h2 class="mt-3 font-display text-3xl font-semibold text-blush-950 sm:text-5xl">Why cenphowax.com</h2>
          <div class="mt-6 space-y-4 text-sm leading-relaxed text-blush-800 sm:text-base">
            <p>
              <strong class="text-blush-950">CenPho Wax</strong> compresses Central Phoenix and the category into a name
              that fits a window, a booking page, and a search result — an exact-match, pronounceable .com for one of the
              largest metro markets in the country.
            </p>
            <p>
              Available for a boutique wax studio, a multi-location beauty operator, or an investor who wants a precise
              Central Phoenix identity with a working content site already attached.
            </p>
          </div>
          <ul class="mt-7 space-y-3 text-sm text-blush-800">
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-champagne-500"></span><span>Exact-match geo + category .com — short, spellable, no hyphens.</span></li>
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-champagne-500"></span><span>Ships with the full site: 18 pages, blog, sitemap, and structured data.</span></li>
            <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-champagne-500"></span><span>Escrow.com protected transfer of registrar and DNS control.</span></li>
          </ul>
        </div>

        <div class="rounded-3xl border border-blush-100 bg-white p-6 text-center shadow-sm sm:p-8">
          <p class="text-[11px] font-medium uppercase tracking-widestx text-blush-600">Asking price</p>
          <p class="mt-3 font-display text-5xl font-semibold tracking-tight text-blush-950 sm:text-6xl">
            <span class="text-champagne-700">$</span>50,000
          </p>
          <p class="mt-2 text-xs uppercase tracking-widestx text-blush-600">USD · Escrow.com protected</p>
          <p class="mt-5 text-sm leading-relaxed text-blush-700">
            Confidential sale handled directly by the owner. Offers and structures are reviewed within 1–2 business days.
          </p>
          <div class="mt-6 flex flex-col gap-3">
            <a
              href="/domain-for-sale/"
              class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-blush-800 px-7 py-3 text-sm font-semibold text-white transition hover:bg-blush-700"
            >
              View acquisition details
            </a>
            <a
              href={acquisitionMailto}
              class="inline-flex min-h-12 w-full items-center justify-center rounded-full border border-blush-300 px-7 py-3 text-sm font-medium text-blush-900 transition hover:bg-blush-100"
            >
              Make an offer
            </a>
          </div>
          <p class="mt-4 text-xs text-blush-600">sales@desertrich.com · Serious inquiries only</p>
        </div>
      </div>
    </section>

    <section class="border-t border-blush-100 bg-white py-10 sm:py-12">
      <div class="container-narrow text-center">
        <p class="mx-auto max-w-2xl text-xs leading-relaxed text-blush-600 sm:text-sm">
          Educational information only — not a substitute for professional skincare or medical advice. Individual
          results vary. Services, availability, and pricing are confirmed at booking.
        </p>
      </div>
    </section>
  </main>

  <Footer />
  </Layout>

  <script>
    const mountStream = () => {
      document.querySelectorAll<HTMLIFrameElement>('iframe[data-src]').forEach((frame) => {
        frame.src = frame.dataset.src || '';
        frame.removeAttribute('data-src');
      });
    };
    if (document.readyState === 'complete') mountStream();
    else window.addEventListener('load', mountStream, { once: true });
  </script>

