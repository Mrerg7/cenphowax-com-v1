---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { services } from '../config/services';
import { site } from '../config/site';

const values = [
  {
    title: 'Hard wax, always',
    body: 'No strip wax on sensitive areas. Hard wax adheres to hair, not skin — the difference is felt on the first pull and visible in the weeks after.',
  },
  {
    title: 'Appointment-led, not high-volume',
    body: 'Private rooms, unhurried sessions, and enough time to consult before waxing starts. You are never rotated through on a timer.',
  },
  {
    title: 'Built for the desert',
    body: 'Aftercare that accounts for Phoenix sun, pools, and dry air — because a waxing routine in the Valley is not the same as one anywhere else.',
  },
];
---

<Layout
  title="About CenPho Wax | Central Phoenix Wax Studio"
  description="CenPho Wax is an appointment-led hard-wax studio in Central Phoenix — private rooms, unhurried sessions, and aftercare built for desert skin."
>
  <Header />
  <Breadcrumbs items={[{ name: 'About', path: '/about/' }]} />

  <main id="main-content" class="flex-1">
    <section class="section-padding bg-white">
      <div class="container-narrow grid gap-12 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <p class="text-[11px] font-medium uppercase tracking-widestx text-blush-600">About</p>
          <h1 class="mt-3 font-display text-4xl font-semibold text-blush-950 sm:text-5xl">
            A wax studio shaped around Central Phoenix
          </h1>
          <div class="prose prose-blush mt-8 max-w-none">
            <p class="lead">
              CenPho Wax started with a simple observation: the best waxing experiences are quiet, private, and
              specific to the person in the room — and none of those things describe a typical high-volume salon floor.
            </p>
            <p>
              The name is shorthand for Central Phoenix — Arcadia, Midtown, Encanto, Uptown, Biltmore, downtown. It
              compresses the city and the craft into one word that fits a window, a booking page, and a search result.
            </p>
            <p>
              We specialize in Brazilian and body waxing with hard wax, because that is what works best on the areas
              clients care about most. Sessions are by appointment in private rooms, with time built in for consultation
              before anything touches your skin.
            </p>
            <h2>What we stand behind</h2>
          </div>

          <div class="mt-6 grid gap-5 sm:grid-cols-3">
            {
              values.map((value) => (
                <article class="card">
                  <h3 class="font-display text-xl font-semibold text-blush-950">{value.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-blush-700">{value.body}</p>
                </article>
              ))
            }
          </div>

          <div class="prose prose-blush mt-10 max-w-none">
            <h2>Serving {site.areasServed.length} Central Phoenix communities</h2>
            <p>
              Clients come from across {site.neighborhoods} — usually within a fifteen-minute drive. If you are unsure
              whether you are in our area, <a href="/contact/">send a note</a> and we will tell you straight.
            </p>
            <h2>New to waxing?</h2>
            <p>
              Start with <a href="/blog/first-brazilian-wax-what-to-expect/">what to expect at your first Brazilian
              wax</a>, browse the <a href="/services/">full service menu</a>, or read the <a href="/faq/">FAQ</a> — most
              first-visit questions are answered there.
            </p>
          </div>
        </div>

        <aside class="lg:col-span-1">
          <div class="sticky top-24 rounded-3xl border border-blush-100 bg-blush-50 p-6">
            <p class="text-[11px] font-medium uppercase tracking-widestx text-blush-600">Studio facts</p>
            <dl class="mt-4 space-y-4 text-sm">
              <div class="flex items-baseline justify-between gap-4 border-b border-blush-100 pb-3">
                <dt class="text-blush-600">Area</dt>
                <dd class="font-medium text-blush-950">Central Phoenix, AZ</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 border-b border-blush-100 pb-3">
                <dt class="text-blush-600">Specialty</dt>
                <dd class="font-medium text-blush-950">Brazilian hard wax</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 border-b border-blush-100 pb-3">
                <dt class="text-blush-600">Format</dt>
                <dd class="font-medium text-blush-950">By appointment</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-blush-600">Services</dt>
                <dd class="font-medium text-blush-950">{services.length} offerings</dd>
              </div>
            </dl>
            <a href="/contact/" class="btn-primary mt-6 flex justify-center">Book a visit</a>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
