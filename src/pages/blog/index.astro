---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormat = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title="Waxing Guides & Tips | CenPho Wax Blog"
  description="Practical waxing guides from a Central Phoenix studio — first visits, hard wax vs soft wax, regrowth timing, aftercare, and desert-climate tips."
>
  <Header />
  <Breadcrumbs items={[{ name: 'Guides', path: '/blog/' }]} />

  <main class="flex-1">
    <section class="section-padding bg-white">
      <div class="container-narrow">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-[11px] font-medium uppercase tracking-widestx text-blush-600">Guides</p>
          <h1 class="mt-3 font-display text-4xl font-semibold text-blush-950 sm:text-5xl">Waxing guides from the studio</h1>
          <p class="mt-4 text-base leading-relaxed text-blush-800 sm:text-lg">
            Straight answers on technique, timing, and aftercare — written for people waxing in the Phoenix climate,
            not lifted from a generic brochure.
          </p>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            posts.map((post) => (
              <article class="card group flex flex-col transition hover:border-champagne-400/60 hover:shadow-md">
                <p class="text-[11px] uppercase tracking-widestx text-blush-500">
                  <time datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time>
                </p>
                <h2 class="mt-3 font-display text-2xl font-semibold leading-snug text-blush-950">
                  <a href={`/blog/${post.id}/`} class="transition group-hover:text-champagne-500">
                    {post.data.title}
                  </a>
                </h2>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-blush-700">{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <p class="mt-4 flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <span class="rounded-full bg-blush-100 px-3 py-1 text-[10px] uppercase tracking-widestx text-blush-600">
                        {tag.replace(/-/g, ' ')}
                      </span>
                    ))}
                  </p>
                )}
                <a href={`/blog/${post.id}/`} class="mt-5 text-sm font-medium text-blush-800 transition group-hover:text-champagne-500">
                  Read guide →
                </a>
              </article>
            ))
          }
        </div>

        <div class="mt-14 flex flex-wrap justify-center gap-4">
          <a href="/services/" class="btn-primary">View services</a>
          <a href="/faq/" class="inline-flex min-h-11 items-center justify-center rounded-full border border-blush-300 px-7 py-3 text-sm font-medium text-blush-900 hover:bg-blush-100">Waxing FAQ</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
